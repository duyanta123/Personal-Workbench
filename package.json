{
  "name": "personal-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental false",
    "lint": "eslint . --max-warnings 0",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:migrations:local": "node scripts/check-migrations.mjs --local-only",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "backup:drill": "node scripts/backup-drill.mjs",
    "test:integration": "node scripts/supabase-integration.mjs",
    "check:v1-retirement": "node scripts/check-v1-retirement.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "ci": "npm run lint && npm run typecheck && npm run test:scripts && npm test && npm run check:migrations:local && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.0",
    "@vercel/analytics": "^2.0.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.1.1"
  }
}
