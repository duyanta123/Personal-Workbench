# 复制本文件为 .env 并填入 Supabase 项目信息（Supabase 控制台 → Project Settings → API）
# 注意：VITE_ 前缀的变量会打包进前端，只允许填 anon 公钥，绝不要填 service_role 密钥
VITE_SUPABASE_URL=https://你的项目ref.supabase.co
VITE_SUPABASE_ANON_KEY=你的anon公钥

# 可选：浏览器错误监控。禁止在此填写 Sentry auth token。
VITE_SENTRY_DSN=
VITE_APP_ENV=production
VITE_APP_RELEASE=git-commit-sha
